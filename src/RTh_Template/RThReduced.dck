* START, STOP and STEP
CONSTANTS 3
START=0
STOP=8760
STEP=1
SIMULATION 	 START	 STOP	 STEP	! Start time	End time	Time step
TOLERANCES 0.001 0.001			! Integration	 Convergence
LIMITS 30 3000 30				! Max iterations	Max warnings	Trace limit
DFQ 1					! TRNSYS numerical integration solver method
WIDTH 80				! TRNSYS output file width, number of characters
LIST 					! NOLIST statement
					! MAP statement
SOLVER 0 1 1				! Solver statement	Minimum relaxation factor	Maximum relaxation factor
NAN_CHECK 0				! Nan DEBUG statement
OVERWRITE_CHECK 0			! Overwrite DEBUG statement
TIME_REPORT 0			! disable time report
EQSOLVER 0				! EQUATION SOLVER statement
* User defined CONSTANTS 
*$USER_CONSTANTS
EQUATIONS 1
nPlots = (STOP-START)/168.
*$USER_CONSTANTS_END


* EQUATIONS "Parameters"
* 
EQUATIONS 15
TSurfAvg = 10.81
TSurfAmpl = 7.27
nDayMin = 22
TSurf = TSurfAvg + TSurfAmpl * sin (360/365*(time/24 - (nDayMin-270)))
SpHeatGround = 0.9074 !kJ/K.kg
DensityGround = 2688.95 ! kg/m3
ThCondGround = 7.002 ! kJ/hr.m.K
WriteStart = 0! 5année
Qcondrated = 15.5 * 3600 * 1000 ! [kJ/hr]
Qevaprated = 7.75 * 3600 * 1000 ! [kJ/hr]
r_in = 2.06 / 1.52
QChillerrated = 13 * 3600 * 1000 !MW to kj/hr
COPChillerrated = 6
THeatingLoop = 75 !°C
TCoolingLoop = 4 !°C
*$UNIT_NAME Parameters
*$LAYER Main
*$POSITION 1019 108
*$UNIT_NUMBER 168

*------------------------------------------------------------------------------


* EQUATIONS "Header"
* 
EQUATIONS 18
ChilledDesiredTemp = TCoolingLoop !°C
HeatDesiredTemp = THeatingLoop! °C
DeltaT_Heat = HeatDesiredTemp  - [125,1]  !°C
DeltaT_Cool = [157,1] - ChilledDesiredTemp  !°C
QHeatAvailable = DeltaT_Heat * [125,2] * 4.19
QCoolAvailable = DeltaT_Cool * [157,2] * 4.19
QExcess_check = QCoolAvailable - Qevaprated/Qcondrated * r_in * QHeatAvailable
IsChiller = GT(QExcess_check  , 0)
QExcess = max(0,QExcess_check)
THeatPAC_in = [125,1]
mDotHeatPAC_in = [125,2]
TCoolPAC_in = [157,1]
mDotCoolPAC_in = (IsChiller) * (QCoolAvailable - QExcess) / DeltaT_Cool / 4.19  +(1-IsChiller) * (QCoolAvailable / DeltaT_Cool / 4.19)
TChiller_in = [157,1]
mDotChillerCool_in = IsChiller * QExcess / DeltaT_Cool / 4.19
TCoolWater_in = [167,3]
mDotCoolWater_in = IsChiller * QExcess * (1+1/4) / 4.19 /  DeltaT_Geo
DeltaT_Geo = 10
*$UNIT_NAME Header
*$LAYER Main
*$POSITION 250 237
*$UNIT_NUMBER 129

*------------------------------------------------------------------------------


