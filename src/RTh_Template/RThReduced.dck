* EQUATIONS "Design-1_1close"
* 
EQUATIONS 16
qdotheat1Rated = 0! Design heating load for heat loop [kJ/h]
qdotCool1Rated = 0! Design cooling load for cool 1 loop [kJ/h]
mdotheat1close = abs([5,2] /4.19 / 30)
mdotheat1middle = abs([179,2] /4.19 / 30)
mdotheat1far = abs([180,2] /4.19 / 30)
mdotcool1close = [5,3] /4.19 / 8
mdotcool1middle = [179,3] /4.19 / 8
mdotcool1far = [180,3] /4.19 / 8
mdotheat1main = (mdotheat1close + mdotheat1middle + mdotheat1far)*1.1
mdotcool1main = ( mdotcool1close  + mdotcool1middle + mdotcool1far)*1.1
mdotheat1Rated = qdotheat1Rated / (4.19*30) ! Design flowrate for heat  loop [kg/h]
PPumpheat1Rated = mdotheat1Rated *0.400 ! Pumping power for heat  loop (assumes 0.4 kW/(m^3/s) [kJ/h]
PumpRatioheat1 = min(max(0.10,ABS(mdotheat1main   /mdotheat1Rated   )), 1)    !Pump control signal (restricted to 10% - 100%)
mdotcool1Rated = qdotCool1Rated  / (4.19*8) ! Design flowrate for cool  loop [kg/h
PPumpcool1Rated = mdotcool1Rated *0.400 ! Pumping power for cool loop (assumes 0.4 kW/(m^3/s) [kJ/h]
PumpRatiocool1 = min(max(0.10, mdotcool1main /mdotcool1Rated  ), 1)    ! Pump control signal (restricted to 10% - 100%)
*$UNIT_NAME Design-1_1close
*$LAYER Main
*$POSITION 1211 671
*$UNIT_NUMBER 15

