* EQUATIONS "Header"
* 
EQUATIONS 18
ChilledDesiredTemp = TCoolingLoop !°C
HeatDesiredTemp = THeatingLoop! °C
DeltaT_Heat = HeatDesiredTemp  - [125,1]  !°C
DeltaT_Cool = [157,1] - ChilledDesiredTemp  !°C
QHeatAvailable = DeltaT_Heat * [125,2] * 4.19
QCoolAvailable = DeltaT_Cool * [157,2] * 4.19
QExcess_check = QCoolAvailable - Qevaprated/Qcondrated * r_in * QHeatAvailable
IsChiller = GT(QExcess_check  , 0)
QExcess = max(0,QExcess_check)
THeatPAC_in = [125,1]
mDotHeatPAC_in = [125,2]
TCoolPAC_in = [157,1]
mDotCoolPAC_in = (IsChiller) * (QCoolAvailable - QExcess) / DeltaT_Cool / 4.19  +(1-IsChiller) * (QCoolAvailable / DeltaT_Cool / 4.19)
TChiller_in = [157,1]
mDotChillerCool_in = IsChiller * QExcess / DeltaT_Cool / 4.19
TCoolWater_in = [167,3]
mDotCoolWater_in = IsChiller * QExcess * (1+1/4) / 4.19 /  DeltaT_Geo
DeltaT_Geo = 10
*$UNIT_NAME Header
*$LAYER Main
*$POSITION 250 237
*$UNIT_NUMBER 129

*------------------------------------------------------------------------------


* EQUATIONS "Design-Main"
* 
EQUATIONS 10
mDotHeatMain = ([14,2]+[37,2]+[60,2]+[82,2]+[104,2]+[126,2])*1.5
mDotColdMain = ([16,2]+[38,2]+[61,2]+[83,2]+[105,2]+[127,2])*1.5
mDotHeatMainRated = 415000*1.1 !kg/hr
mDotColdMainRated = 1100000*1.1 !kg/hr
signalHeat = max(0.3, min(ABS(mDotHeatMain/mDotHeatMainRated), 1))
signalCold = max(0.3, min(ABS(mDotColdMain/mDotColdMainRated), 1))
PPumpMainHeatRated = mDotHeatMainRated * 0.900 !kW/L.s
PPumpMainColdRated = mDotColdMainRated * 0.900 !kW/L.s
AboveHeat = gt(mDotHeatMain, mDotHeatMainRated)
AboveCold = gt(mDotColdMain, mDotColdMainRated)
*$UNIT_NAME Design-Main
*$LAYER Main
*$POSITION 1019 301
*$UNIT_NUMBER 132

*------------------------------------------------------------------------------


