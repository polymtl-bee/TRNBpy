PROPERTIES
 DENSITY=1.204 : CAPACITY=1.012 : PRESSURE=101325.000 : HVAPOR=2454.0 : SIGMA=2.041e-007 : RTEMP=293.15
*--- convective heat transfer coefficient calculation ---------------------
 KFLOORUP=7.2 : EFLOORUP=0.31 : KFLOORDOWN=3.888 : EFLOORDOWN=0.31
 KCEILUP=7.2 : ECEILUP=0.31 : KCEILDOWN=3.888 : ECEILDOWN=0.31
 KVERTICAL=5.76 : EVERTICAL=0.3
*--- radiance parameters -------------------
 SCENE_ROTATION_ANGLE=0 : GROUND_IDS= : GROUND_REFLECTANCE=0.2 : SHADER_REFLECTANCE=0
 CALC_MODE=RAD : LATITUDE=48 : LONGITUDE=-9.2 : TIME_ZONE=-15 : SITE_ELEVATION=200
 AB=5 : AD=1000 : AS=20 : AR=300 : AA=0.1
 LR=6 : ST=0.15 : SJ=1 : LW=0.004 : DJ=0 : DS=0.2 : DR=2 : DP=512
*--- comfort parameters -------------------
 DIAM-SENSOR=0.07 : EPS-SENSOR=0.82 : REFL-SENSOR=0.47 : ELV_AIRSPEED1=0.3 : ELV_AIRSPEED2=0.7 : ELV_AIRSPEED3=1.2
*--- solar matrix parameters -------------------
 FSCAL_TREGENZA=MEDIUM : SHM_MODE=0 : SURFGRID=0.2 : GRIDDISTANCE=0.03
*--- daylight  -------------------
 UDIMIN=100 : UDIMAX=2000 : DAMIN=300
*
*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
TYPES
*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
*
*--------------------------------------------------------------------------------
*  L a y e r s
*--------------------------------------------------------------------------------
LAYER PanPla
 CONDUCTIVITY=   0.576 : CAPACITY=      1.09 : DENSITY=   800 : PERT=      0 : PENRT=      0
LAYER IsoIntMurExt
 CONDUCTIVITY=  0.12 : CAPACITY=      0.71 : DENSITY=   10 : PERT=      0 : PENRT=      0
LAYER CouProExt
 CONDUCTIVITY=  0.576 : CAPACITY=      1.09 : DENSITY=     7830 : PERT=      0 : PENRT=      0
LAYER IsoExtMurExt
 CONDUCTIVITY=  0.18 : CAPACITY=      1.22 : DENSITY=    600 : PERT=      0 : PENRT=      0
LAYER RecBri
 CONDUCTIVITY=  2.808 : CAPACITY=    0.72 : DENSITY=    1920 : PERT=      0 : PENRT=      0
LAYER DalBetToi
 CONDUCTIVITY=   6.48 : CAPACITY=      0.85 : DENSITY=   2250 : PERT=      0 : PENRT=      0
LAYER IsoExtToiExt
 CONDUCTIVITY=  0.5 : CAPACITY=    1.22 : DENSITY=    28 : PERT=      0 : PENRT=      0
LAYER ToiMul
 CONDUCTIVITY=   0.583 : CAPACITY=      1.47 : DENSITY=   1121 : PERT=      0 : PENRT=      0
LAYER BetCoule
 CONDUCTIVITY=  4.774 : CAPACITY=      0.912 : DENSITY=     1842 : PERT=      0 : PENRT=      0
LAYER DalBetFlo
 CONDUCTIVITY=  8.316 : CAPACITY=      0.832 : DENSITY=     2322 : PERT=      0 : PENRT=      0
LAYER TuileAcoust
 CONDUCTIVITY=  0.22 : CAPACITY=      0.59 : DENSITY=     368 : PERT=      0 : PENRT=      0
LAYER IsoGroToi
 CONDUCTIVITY=  0.09 : CAPACITY=      1.22 : DENSITY=     800: PERT=      0 : PENRT=      0
LAYER IsoGroFlo
 CONDUCTIVITY=  0.22 : CAPACITY=      1.22 : DENSITY=     800 : PERT=      0 : PENRT=      0
LAYER AirLayer
 RESISTANCE= 0.044 : PERT=      0 : PENRT=      0
LAYER CarpetLayer
 RESISTANCE= 0.06 : PERT=      0 : PENRT=      0
*--------------------------------------------------------------------------------
*  I n p u t s
*--------------------------------------------------------------------------------
INPUTS TGROUND TBOUNDARY SHADE_CLOSE SHADE_OPEN MAX_ISHADE MAX_ESHADE
INPUTS_DESCRIPTION
 TGROUND : any : Input
 TBOUNDARY : any : Input
 SHADE_CLOSE : any : Input
 SHADE_OPEN : any : Input
 MAX_ISHADE : any : Input
 MAX_ESHADE : any : Input
*--------------------------------------------------------------------------------
*  S c h e d u l e s
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  C O N S T R U C T I O N (Wall, Floor, Ceiling,..)
*--------------------------------------------------------------------------------
CONSTRUCTION EXT_WALL
 LAYERS   = PanPla  IsoIntMurExt CouProExt IsoExtMurExt AirLayer RecBri   
 THICKNESS= 0.013 0.092 0.013 0.092  0 0.092
 ABS-FRONT= 0.4   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 22 : HBACK= 125
CONSTRUCTION EXT_ROOF
 LAYERS   = DalBetToi IsoExtToiExt ToiMul 
 THICKNESS= 0.203 0.102  0.01
 ABS-FRONT= 0.1   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 32 : HBACK= 125
CONSTRUCTION GROUND_FLOOR
 LAYERS   = DalBetFlo IsoGroFlo  
 THICKNESS= 0.203 0.102
 ABS-FRONT= 0.8   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 32 : HBACK= 0.001
CONSTRUCTION GROUND_WALL
 LAYERS   = BetCoule  IsoGroToi  
 THICKNESS= 0.203 0.102 
 ABS-FRONT= 0.4   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 22 : HBACK= 0.001
CONSTRUCTION ADJ_WALL
 LAYERS   = PanPla  AirLayer PanPla  
 THICKNESS= 0.016 0   0.016 
 ABS-FRONT= 0.4   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 22 : HBACK= 22
CONSTRUCTION ADJ_CEILING
 LAYERS   = CarpetLayer DalBetFlo AirLayer TuileAcoust  
 THICKNESS= 0 0.203 0  0.013 
 ABS-FRONT= 0.8   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 32 : HBACK= 32
*--------------------------------------------------------------------------------
*  W i n d o w s
*--------------------------------------------------------------------------------
 WINDOW EXT_WINDOW1
 WINID=6505 : HINSIDE=11 : HOUTSIDE=64 : SLOPE=-999 : SPACID=4 : WWID=0.77 : WHEIG=1.08 : FFRAME=0.15 : UFRAME=2.52 : ABSFRAME=0.6 : RISHADE=0 : RESHADE=0 : REFLISHADE=0.5 : REFLOSHADE=0.5 : CCISHADE=0.5 : EPSFRAME=0.9 : EPSISHADE=0.9 : ITSHADECLOSE=INPUT 1*SHADE_CLOSE : ITSHADEOPEN=INPUT 1*SHADE_OPEN : FLOWTOAIRNODE=1 : PERT=0 : PENRT=0 : RADMATERIAL=undefined : RADMATERIAL_SHD1=undefined
*--------------------------------------------------------------------------------
*  G a i n s / L o s s e s
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  C o m f o r t
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  I n f i l t r a t i o n
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  V e n t i l a t i o n
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  C o o l i n g
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  H e a t i n g
*--------------------------------------------------------------------------------
*--------------------------------------------------------------------------------
*  D a y l i g h t   C o n t r o l 
*--------------------------------------------------------------------------------
*
*--------------------------------------------------------------------------------
*  Z o n e s
*--------------------------------------------------------------------------------
ZONES 

*--------------------------------------------------------------------------------
*  O r i e n t a t i o n s
*--------------------------------------------------------------------------------
HEMISPHERE NORTHERN
ORIENTATIONS H_0_0 S_0_90 W_90_90 N_180_90 E_270_90
INTERNAL_CALCULATION H_0_0 S_0_90 W_90_90 N_180_90 E_270_90
*
*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
BUILDING
*++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

*--------------------------------------------------------------------------------
*  Z o n e ExempleName  /  A i r n o d e  ExempleName
*--------------------------------------------------------------------------------
ZONE ExempleName
RADIATIONMODE
 BEAM=STANDARD : DIFFUSE=STANDARD : LONGWAVE=STANDARD : GEOMODE=3D_DATA : FSOLAIR=0
DAYLIGHTMODE
 DLSHADE =-1
AIRNODE ExempleName
WALL         =GROUND_WALL   : SURF=  1 : AREA=        72 : BOUNDARY=INPUT 1*TGROUND : GEOSURF=0.052174
WALL         =GROUND_WALL   : SURF=  2 : AREA=        66 : BOUNDARY=INPUT 1*TGROUND : GEOSURF=0.047826
WALL         =GROUND_WALL   : SURF=  4 : AREA=        72 : BOUNDARY=INPUT 1*TGROUND : GEOSURF=0.052174
WALL         =GROUND_WALL   : SURF=  5 : AREA=        66 : BOUNDARY=INPUT 1*TGROUND : GEOSURF=0.047826
CEILING      =ADJ_CEILING : SURF=  6 : AREA=        80 : ADJACENT=ExempleName2 : ADJ_SURF=175 : FRONT
FLOOR        =GROUND_FLOOR : SURF=  7 : AREA=       528 : BOUNDARY=INPUT 1*TGROUND : GEOSURF=0.8
 REGIME
 CAPACITANCE = 1900.8  : VOLUME= 1584    : REFAREA= 528     : TINITIAL= 20      : PHINITIAL= 50      : WCAPR= 1

*--------------------------------------------------------------------------------
*  O u t p u t s
*--------------------------------------------------------------------------------
OUTPUTS
 TRANSFER : TIMEBASE=1.000
 AIRNODES = ExempleName
 NTYPES =   1 : TAIR - air temperature of airnode
        =  25 : TOP - obsolete use new comfort outputs (Version 16: Operative temperature)
        =  30 : QHEAT - sensible heating demand of airnode (positive values)
        =  31 : QCOOL - sensible cooling demand of airnode (positive values)
        = 156 : QELEQUIP - Electric energy demand of "equipment" gains of airnode [kJ/hr]
        = 155 : QELLIGHT - Electric energy demand of "lights" gains of airnode [kJ/hr]
*--------------------------------------------------------------------------------
*  E n d
*--------------------------------------------------------------------------------
END

