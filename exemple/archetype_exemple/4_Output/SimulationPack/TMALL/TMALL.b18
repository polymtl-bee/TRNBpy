*-----------------------------------------------------------------------------------------------------------------------
*  L a y e r s
*-----------------------------------------------------------------------------------------------------------------------
LAYER PanPla
 CONDUCTIVITY=   0.576 : CAPACITY=      1.09 : DENSITY=   800 : PERT=      0 : PENRT=      0
LAYER IsoIntMurExt
 CONDUCTIVITY=  0.12 : CAPACITY=      0.71 : DENSITY=   10 : PERT=      0 : PENRT=      0
LAYER CouProExt
 CONDUCTIVITY=  0.576 : CAPACITY=      1.09 : DENSITY=     7830 : PERT=      0 : PENRT=      0
LAYER IsoExtMurExt
 CONDUCTIVITY=  0.18 : CAPACITY=      1.22 : DENSITY=    600 : PERT=      0 : PENRT=      0
LAYER RecBri
 CONDUCTIVITY=  2.808 : CAPACITY=    0.72 : DENSITY=    1920 : PERT=      0 : PENRT=      0
LAYER DalBetToi
 CONDUCTIVITY=   6.48 : CAPACITY=      0.85 : DENSITY=   2250 : PERT=      0 : PENRT=      0
LAYER IsoExtToiExt
 CONDUCTIVITY=  0.5 : CAPACITY=    1.22 : DENSITY=    28 : PERT=      0 : PENRT=      0
LAYER ToiMul
 CONDUCTIVITY=   0.583 : CAPACITY=      1.47 : DENSITY=   1121 : PERT=      0 : PENRT=      0
LAYER BetCoule
 CONDUCTIVITY=  4.774 : CAPACITY=      0.912 : DENSITY=     1842 : PERT=      0 : PENRT=      0
LAYER DalBetFlo
 CONDUCTIVITY=  8.316 : CAPACITY=      0.832 : DENSITY=     2322 : PERT=      0 : PENRT=      0
LAYER TuileAcoust
 CONDUCTIVITY=  0.22 : CAPACITY=      0.59 : DENSITY=     368 : PERT=      0 : PENRT=      0
LAYER IsoGroToi
 CONDUCTIVITY=  0.09 : CAPACITY=      1.22 : DENSITY=     800: PERT=      0 : PENRT=      0
LAYER IsoGroFlo
 CONDUCTIVITY=  0.22 : CAPACITY=      1.22 : DENSITY=     800 : PERT=      0 : PENRT=      0
LAYER AirLayer
 RESISTANCE= 0.044 : PERT=      0 : PENRT=      0
LAYER CarpetLayer
 RESISTANCE= 0.06 : PERT=      0 : PENRT=      0
*-----------------------------------------------------------------------------------------------------------------------
*  I n p u t s
*-----------------------------------------------------------------------------------------------------------------------
INPUTS TGROUND TBOUNDARY SHADE_CLOSE SHADE_OPEN MAX_ISHADE MAX_ESHADE ;
$INPUT_horexC_vent ;
$INPUT_horexC_lum ;
$INPUT_horexC_heat ;
$INPUT_horexC_occ ;
$INPUT_horexC_cool ;
$INPUT_horexC_eq ;
$INPUT_horexB_lum ;
$INPUT_horexB_vent ;
$INPUT_horexB_eq ;
$INPUT_horexB_cool ;
$INPUT_horexB_occ ;
$INPUT_horexB_heat
INPUTS_DESCRIPTION
 TGROUND : �C : Ground Temperature (boundary temperature used for floors adjacent to the ground)
 TBOUNDARY : �C : Boundary Temperature (boundary temperature used for boundary floors, walls, ceilings)
 SHADE_CLOSE : kJ/hr.m^2 : threshold of total radiation on facade where shading device is activated
 SHADE_OPEN : kJ/hr.m^2 : threshold of total radiation on facade where shading device is deactivated
 MAX_ISHADE : any : max shading factor of internal shading
 MAX_ESHADE : any : max shading factor of external shading
*--------------------------------------------------------------------------------
*  S c h e d u l e s
*--------------------------------------------------------------------------------

*--------------------------------------------------------------------------------
*  C O N S T R U C T I O N (Wall, Floor, Ceiling,..)
*--------------------------------------------------------------------------------
CONSTRUCTION EXT_WALL
 LAYERS   = PanPla  IsoIntMurExt CouProExt IsoExtMurExt AirLayer RecBri   
 THICKNESS= 0.013 0.092 0.013 0.092  0 0.092
 ABS-FRONT= 0.4   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 22 : HBACK= 125
CONSTRUCTION EXT_ROOF
 LAYERS   = DalBetToi IsoExtToiExt ToiMul 
 THICKNESS= 0.203 0.102  0.01
 ABS-FRONT= 0.1   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 32 : HBACK= 125
CONSTRUCTION GROUND_FLOOR
 LAYERS   = DalBetFlo IsoGroFlo  
 THICKNESS= 0.203 0.102
 ABS-FRONT= 0.8   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 32 : HBACK= 0.001
CONSTRUCTION GROUND_WALL
 LAYERS   = BetCoule  IsoGroToi  
 THICKNESS= 0.203 0.102 
 ABS-FRONT= 0.4   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 22 : HBACK= 0.001
CONSTRUCTION ADJ_WALL
 LAYERS   = PanPla  AirLayer PanPla  
 THICKNESS= 0.016 0   0.016 
 ABS-FRONT= 0.4   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 22 : HBACK= 22
CONSTRUCTION ADJ_CEILING
 LAYERS   = CarpetLayer DalBetFlo AirLayer TuileAcoust  
 THICKNESS= 0 0.203 0  0.013 
 ABS-FRONT= 0.8   : ABS-BACK= 0.5  
 EPS-FRONT= 0.9   : EPS-BACK= 0.9  
 HFRONT   = 32 : HBACK= 32
*--------------------------------------------------------------------------------
*  W i n d o w s
*--------------------------------------------------------------------------------
 WINDOW EXT_WINDOW1
 WINID=6505 : HINSIDE=11 : HOUTSIDE=64 : SLOPE=-999 : SPACID=4 : WWID=0.77 : WHEIG=1.08 : FFRAME=0.15 : UFRAME=2.52 : ABSFRAME=0.6 : RISHADE=0 : RESHADE=0 : REFLISHADE=0.5 : REFLOSHADE=0.5 : CCISHADE=0.5 : EPSFRAME=0.9 : EPSISHADE=0.9 : ITSHADECLOSE=INPUT 1*SHADE_CLOSE : ITSHADEOPEN=INPUT 1*SHADE_OPEN : FLOWTOAIRNODE=1 : PERT=0 : PENRT=0 : RADMATERIAL=undefined : RADMATERIAL_SHD1=undefined
*-----------------------------------------------------------------------------------------------------------------------
*  G a i n s
*-----------------------------------------------------------------------------------------------------------------------
 GAIN gain_com_people
 CONVECTIVE=INPUT 3.8 * $INPUT_horexC_occ : RADIATIVE=INPUT 5.2 * $INPUT_horexC_occ : HUMIDITY=INPUT 0.0027 * $INPUT_horexC_occ : ELPOWERFRAC=0 : AREA_RELATED : CATEGORY=PEOPLE
 GAIN gain_com_eq
 CONVECTIVE=INPUT 9.0 * $INPUT_horexC_eq : RADIATIVE=INPUT 0 * $INPUT_horexC_eq : HUMIDITY=INPUT 0 * $INPUT_horexC_eq : ELPOWERFRAC=1 : AREA_RELATED : CATEGORY=EQUIPMENT
 GAIN gain_com_light
 CONVECTIVE=INPUT 27.2 * $INPUT_horexC_lum : RADIATIVE=INPUT 5.2 * $INPUT_horexC_lum : HUMIDITY=INPUT 0 * $INPUT_horexC_lum : ELPOWERFRAC=1 : AREA_RELATED : CATEGORY=LIGHTS
 GAIN gain_barpeople_1
 CONVECTIVE=INPUT 12.1 * $INPUT_horexB_occ : RADIATIVE=INPUT 16.7 * $INPUT_horexB_occ : HUMIDITY=INPUT 0.0117 * $INPUT_horexB_occ : ELPOWERFRAC=0 : AREA_RELATED : CATEGORY=PEOPLE
 GAIN gain_bareq_1
 CONVECTIVE=INPUT 3.6 * $INPUT_horexB_eq : RADIATIVE=INPUT 0 * $INPUT_horexB_eq : HUMIDITY=INPUT 0 * $INPUT_horexB_eq : ELPOWERFRAC=1 : AREA_RELATED : CATEGORY=EQUIPMENT
 GAIN gain_barlight_1
 CONVECTIVE=INPUT 26.0 * $INPUT_horexB_lum : RADIATIVE=INPUT 5.0 * $INPUT_horexB_lum : HUMIDITY=INPUT 0 * $INPUT_horexB_lum : ELPOWERFRAC=1 : AREA_RELATED : CATEGORY=LIGHTS
*-----------------------------------------------------------------------------------------------------------------------
